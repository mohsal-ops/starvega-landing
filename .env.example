# ── 3-hourly digest email (app/api/digest, scheduled by vercel.json cron) ────
# Set these on Vercel. SMTP_* can be copied from the builder's SHARED_SMTP_*.
# If SMTP_HOST or TRACK_NOTIFY_TO is missing, the digest just no-ops.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TRACK_NOTIFY_TO=         # where the 3-hourly digest is sent
TRACK_NOTIFY_FROM=       # optional; defaults to SMTP_USER


# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to /api/digest.
CRON_SECRET=

# ── Analytics + admin ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=   # optional GA4 id, e.g. G-XXXXXXX
GOOGLE_SITE_VERIFICATION=        # optional; Search Console "HTML tag" token
                                 # (renders <meta name="google-site-verification">)
DATABASE_URL=                    # Neon pooled URL (analytics DB)
ADMIN_PASSWORD=                  # /admin gate
ADMIN_SECRET=                    # any long random string

# ── Paid checkout (PayPal) — ad-funnel: preview -> /checkout/[leadId] ─────────
# Sandbox creds in dev, live creds in Production (set per-environment on Vercel).
# The single price lives in code (lib/pricing.ts BUILD_PRICE_USD), not here.
NEXT_PAYPAL_CLIENT_ID=    # PayPal app client id (safe in the browser)
PAYPAL_CLIENT_SECRET=            # PayPal app secret (server only — never exposed)
# PAYPAL_ENV=sandbox             # optional override; defaults sandbox in dev, live in prod

# ── Paid onboarding -> builder handoff (creates the Project in the Projects tab)
BUILDER_API_URL=                 # builder base URL, e.g. https://panel.example.com
PAID_HANDOFF_SECRET=             # shared bearer secret; MUST match the builder's value
