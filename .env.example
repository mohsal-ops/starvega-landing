# ── Visitor notifier (app/api/track-visit) ──────────────────────────────────
# Set these on Vercel (Project → Settings → Environment Variables) to receive an
# email per new visitor session. You can copy the SMTP_* values from the builder
# panel's SHARED_SMTP_* secrets. If SMTP_HOST or TRACK_NOTIFY_TO is missing, the
# tracker just no-ops (no emails, no errors).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bensa0016@gmail.com
SMTP_PASS=kikz uzoh nmqx uiih
TRACK_NOTIFY_TO=bensa0016@gmail.com
TRACK_NOTIFY_FROM=        # optional; defaults to SMTP_USER
TRACK_EXCLUDE_IPS=        # optional, comma-separated IPs to never email about

# ── Analytics (optional) ─────────────────────────────────────────────────────
# New dedicated GA4 property's measurement id, e.g. G-XXXXXXX. Omit to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C8WWXXEM3P

# Analytics DB (Neon). Provisioned separately; add the pooled URL in Vercel.
DATABASE_URL=

# Admin dashboard (single-admin gate at /admin)
ADMIN_PASSWORD=
ADMIN_SECRET=
