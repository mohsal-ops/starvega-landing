# ── 3-hourly digest email (app/api/digest, scheduled by vercel.json cron) ────
# Set these on Vercel. SMTP_* can be copied from the builder's SHARED_SMTP_*.
# If SMTP_HOST or TRACK_NOTIFY_TO is missing, the digest just no-ops.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TRACK_NOTIFY_TO=         # where the 3-hourly digest is sent
TRACK_NOTIFY_FROM=       # optional; defaults to SMTP_USER
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to /api/digest.
CRON_SECRET=

# ── Analytics + admin ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=   # optional GA4 id, e.g. G-XXXXXXX
DATABASE_URL=                    # Neon pooled URL (analytics DB)
ADMIN_PASSWORD=                  # /admin gate
ADMIN_SECRET=                    # any long random string
