// Starvega marketing-site analytics DB (separate from client/builder DBs).
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PageEvent {
  id          String   @id @default(cuid())
  sessionId   String
  eventType   String // "pageview" | "section_view" | "widget_opened" | "widget_submitted" | "preview_generated" | "onboarding_clicked"
  sectionId   String? // "hook" | "agitate" | "turn" | "proof" | "offer" | "objections" | "cta"
  // Which door opened the widget (set on widget_opened): "sticky_nav" | "post_hook" | "post_proof" | "final_cta"
  entryPoint  String?
  path        String
  referrer    String?
  country     String?
  city        String?
  // Device class parsed server-side from the User-Agent at ingest ("mobile" |
  // "tablet" | "desktop"). Null on rows created before device capture existed.
  device      String?
  isReturning Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}

model InstantDemoLead {
  id           String   @id @default(cuid())
  businessName String
  businessType String?
  photoUrls    String[]
  contact      String?  // phone / WhatsApp for mockup-form leads
  // Mockup-form leads (the landing's main CTA): who to message + an optional
  // email. source = "mockup_form" | null (older instant-demo builder leads).
  ownerName    String?
  email        String?
  source       String?
  country      String?
  city         String?
  status       String   @default("new") // new | reviewed | contacted | converted
  sessionId    String?
  config       Json?    // full generated DemoConfig, so the exact preview can be reloaded
  createdAt    DateTime @default(now())

  // Chosen product tier (STARTER | STANDARD | PRO). Drives the checkout amount,
  // validated server-side from lib/pricing PACKAGES — never trusted from the
  // client. Null on pre-packs leads, which fall back to the legacy build price.
  packTier      String?

  // Paid ad-funnel checkout (PayPal). Only the server capture flips this to
  // "paid"; a client-side approval never does. See /checkout/[leadId] +
  // /api/paypal/*. The free manual path (builder /onboard/[slug]) never touches
  // these fields.
  paypalOrderId String?
  paymentStatus String    @default("unpaid") // unpaid | pending | paid
  paidAt        DateTime?
  amountPaid    Decimal?

  // Gated onboarding submission from /onboard/paid/[leadId] (only reachable once
  // paid). Stored as JSON: { story, hoursNote, menuChanges, requests,
  // paymentReady, photos[] } — the same fields as the builder's /onboard/[slug].
  onboarding    Json?

  // Set once the paid submission has been handed off to the builder and a
  // Project row was created there (Phase 4). status flips to "converted" too.
  projectId     String?
}

// ── Client platform (offer v3, 2026-11) ─────────────────────────────────────
// A restaurant that signed up for a monthly plan gets an Account: a login (email
// code, no password), their plan + PayPal subscription, invoices, the work Ben
// did for them (ClientUpdate) and the changes they asked for (ClientRequest).
// Managed by Ben in /admin/clients. See lib/billing.ts + lib/account-auth.ts.

model Account {
  id             String    @id @default(cuid())
  email          String    @unique
  ownerName      String?
  restaurantName String
  phone          String?
  city           String?
  // Their site once it exists, and where it stands: "onboarding" (waiting for
  // their basics) | "building" | "review" | "live".
  siteUrl        String?
  siteStatus     String    @default("onboarding")
  // Builder panel project slug once handed off (links the two systems).
  builderSlug    String?
  // The InstantDemoLead row that holds their onboarding form (reuses
  // /onboard/paid/[leadId]).
  leadId         String?
  // Guarantee tracking: direct orders counted so far (Ben updates it from the
  // client site's dashboard each month) and when the 90 days started (go-live).
  directOrders   Int       @default(0)
  guaranteeStart DateTime?
  bagCardCode    String?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?

  subscriptions Subscription[]
  invoices      Invoice[]
  updates       ClientUpdate[]
  requests      ClientRequest[]
  loginCodes    LoginCode[]
}

// One-time sign-in codes emailed to the owner (hashed, 15 minutes, 5 tries).
model LoginCode {
  id        String   @id @default(cuid())
  accountId String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// A plan the restaurant pays monthly through PayPal Subscriptions.
model Subscription {
  id                String    @id @default(cuid())
  accountId         String
  // "founding" | "regulars" | "care" (see lib/billing.ts PLANS)
  plan              String
  provider          String    @default("paypal")
  providerSubId     String    @unique
  // PayPal status, lowercased: approval_pending | approved | active | suspended
  // | cancelled | expired
  status            String
  monthlyCents      Int
  setupCents        Int       @default(0)
  startedAt         DateTime  @default(now())
  nextBillingAt     DateTime?
  lastPaymentAt     DateTime?
  failedPayments    Int       @default(0)
  cancelledAt       DateTime?
  cancelReason      String?
  updatedAt         DateTime  @updatedAt
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([plan, status])
}

model Invoice {
  id             String   @id @default(cuid())
  accountId      String
  subscriptionId String?
  // PayPal sale / capture id - unique so a webhook retry never double-counts.
  providerTxnId  String   @unique
  amountCents    Int
  currency       String   @default("USD")
  description    String
  paidAt         DateTime
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, paidAt])
}

// The work done for them, shown on their dashboard: "campaign" (a text went
// out), "report" (monthly report), "site" (site change), "card" (bag cards),
// "google" (Google listing), "note". metric = an optional number (orders, texts).
model ClientUpdate {
  id        String   @id @default(cuid())
  accountId String
  kind      String
  title     String
  body      String?  @db.Text
  metric    String?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

// "Ask for a change" from their dashboard. status: open | done
model ClientRequest {
  id        String    @id @default(cuid())
  accountId String
  message   String    @db.Text
  status    String    @default("open")
  reply     String?   @db.Text
  createdAt DateTime  @default(now())
  doneAt    DateTime?
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
}

// PayPal product/plan ids created on first use, per environment (sandbox/live).
model BillingPlan {
  key          String   @id // "<env>:<plan>"  e.g. "live:regulars"
  paypalPlanId String
  createdAt    DateTime @default(now())
}

// A sign-up started on /start, before PayPal approves the subscription. Holds
// what they typed so the account can be created from it once payment is real.
model PendingSignup {
  id             String   @id @default(cuid())
  plan           String
  email          String
  ownerName      String?
  restaurantName String
  phone          String?
  city           String?
  createdAt      DateTime @default(now())
}
