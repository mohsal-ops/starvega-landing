// Starvega marketing-site analytics DB (separate from client/builder DBs).
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PageEvent {
  id          String   @id @default(cuid())
  sessionId   String
  eventType   String // "pageview" | "section_view" | "widget_opened" | "widget_submitted" | "preview_generated" | "onboarding_clicked"
  sectionId   String? // "hook" | "agitate" | "turn" | "proof" | "offer" | "objections" | "cta"
  // Which door opened the widget (set on widget_opened): "sticky_nav" | "post_hook" | "post_proof" | "final_cta"
  entryPoint  String?
  path        String
  referrer    String?
  country     String?
  city        String?
  isReturning Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}

model InstantDemoLead {
  id           String   @id @default(cuid())
  businessName String
  businessType String?
  photoUrls    String[]
  contact      String?
  country      String?
  city         String?
  status       String   @default("new") // new | reviewed | contacted | converted
  sessionId    String?
  config       Json?    // full generated DemoConfig, so the exact preview can be reloaded
  createdAt    DateTime @default(now())

  // Chosen product tier (STARTER | STANDARD | PRO). Drives the checkout amount,
  // validated server-side from lib/pricing PACKAGES — never trusted from the
  // client. Null on pre-packs leads, which fall back to the legacy build price.
  packTier      String?

  // Paid ad-funnel checkout (PayPal). Only the server capture flips this to
  // "paid"; a client-side approval never does. See /checkout/[leadId] +
  // /api/paypal/*. The free manual path (builder /onboard/[slug]) never touches
  // these fields.
  paypalOrderId String?
  paymentStatus String    @default("unpaid") // unpaid | pending | paid
  paidAt        DateTime?
  amountPaid    Decimal?

  // Gated onboarding submission from /onboard/paid/[leadId] (only reachable once
  // paid). Stored as JSON: { story, hoursNote, menuChanges, requests,
  // paymentReady, photos[] } — the same fields as the builder's /onboard/[slug].
  onboarding    Json?

  // Set once the paid submission has been handed off to the builder and a
  // Project row was created there (Phase 4). status flips to "converted" too.
  projectId     String?
}
